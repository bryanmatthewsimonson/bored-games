{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-e2e",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!packages/deck/test/vectors",
      "!packages/protocol/test/vectors",
      "!packages/client/test/vectors",
      "!packages/client/test/golden-v1/*.json",
      "!packages/games/bank/test/golden-v1/*.json",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
